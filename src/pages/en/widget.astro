---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/net-comparison/" title="Net comparison: Italian BTP, BOT, postal bonds and deposits" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the BTP, postal bond and deposit net comparison" description="Embed for free on your site the net comparison of Italian BTP, BOT, postal savings bonds and deposit accounts with an iframe: one code to copy, no sign-up, no cookies." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the net comparison on your site</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, with no sign-up and no cost. Savings blogs, local newspapers and consumer groups set it up in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link under the tool stays visible, the tool is not altered and comes with no warranty. When we update auction prices and rates, the frame updates on your page too. Italian version: <code>{`${SITE_URL}/embed/confronto-netto/`}</code>.</p>
    <p>Amounts typed by your visitors stay in their browser: nothing goes through our servers and the frame sets no cookie on your site. For any request use the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/net-comparison/" title="Net comparison: Italian BTP, BOT, postal bonds and deposits" width="100%" height="1100" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
