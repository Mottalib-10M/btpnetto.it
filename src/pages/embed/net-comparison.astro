---
/** Page à incorporer (iframe) : le confronto netto sans navigation. noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import SpecTool from '../../components/calc/SpecTool';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { P } from '../../lib/engine/params';
import { displayDate } from '../../lib/format';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Net comparison: Italian BTP, BOT, postal bonds and deposits – widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <SpecTool client:load kind="confronto" lang="en" id="embed" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES['en']}</a> · data reread on {displayDate(P.retrieved_at, 'en-GB')}</p>
  </body>
</html>
